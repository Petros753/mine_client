// =====================================================
// СХЕМА БАЗЫ ДАННЫХ — Платформа автоматизации сферы услуг
// Аналог YCLIENTS: мультитенантная SaaS-платформа
// =====================================================

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: url подключения больше не указывается в схеме —
// см. prisma.config.ts (для CLI/migrate) и src/lib/prisma.ts (для рантайма)
datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------
// 1. КОМПАНИИ И ФИЛИАЛЫ (мультитенантность)
// -----------------------------------------------------

// Компания — верхний уровень (аккаунт клиента платформы)
model Company {
  id        String   @id @default(cuid())
  name      String
  industry  Industry @default(BEAUTY) // ниша: салон, автомойка, психолог и т.д.
  timezone  String   @default("Europe/Moscow")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      Branch[]
  users         User[]
  subscription  Subscription?
  loyaltyRules  LoyaltyRule[]

  @@map("companies")
}

// Филиал — конкретная точка (адрес, расписание)
model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String?
  phone     String?
  latitude  Float?
  longitude Float?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   Employee[]
  services    Service[]
  clients     Client[]
  appointments Appointment[]
  workingHours WorkingHours[]
  warehouses   Warehouse[]
  inventoryTransactions InventoryTransaction[]

  @@index([companyId])
  @@map("branches")
}

enum Industry {
  BEAUTY          // салоны красоты
  BARBERSHOP
  FITNESS
  MEDICAL
  CARWASH
  AUTO_SERVICE
  AUTO_SCHOOL
  PSYCHOLOGY
  QUEST_ROOM
  EDUCATION
  OTHER
}

// -----------------------------------------------------
// 2. ПОЛЬЗОВАТЕЛИ И ПЕРСОНАЛ
// -----------------------------------------------------

// Пользователь платформы (владелец, админ, мастер)
model User {
  id           String   @id @default(cuid())
  companyId    String   // к какой компании относится аккаунт (арендатор)
  email        String   @unique
  phone        String?
  passwordHash String
  firstName    String
  lastName     String?
  avatarUrl    String?
  role         UserRole @default(EMPLOYEE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeProfile Employee?

  @@index([companyId])
  @@map("users")
}

enum UserRole {
  OWNER      // владелец компании — полный доступ
  ADMIN      // администратор филиала
  EMPLOYEE   // мастер/специалист
}

// Профиль сотрудника, привязанный к филиалу
model Employee {
  id         String   @id @default(cuid())
  userId     String   @unique
  branchId   String
  position   String? // должность: "мастер маникюра"
  bio        String?
  isBookable Boolean  @default(true) // можно ли записаться к нему онлайн
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  services     EmployeeService[]
  appointments Appointment[]
  schedule     EmployeeSchedule[]
  invitations  InvitationToken[]

  @@index([branchId])
  @@map("employees")
}

// Приглашение сотрудника: одноразовая ссылка для установки пароля.
// Пока usedAt = null и expiresAt в будущем — ссылка действительна.
model InvitationToken {
  id         String    @id @default(cuid())
  employeeId String
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("invitation_tokens")
}

// Индивидуальный график работы сотрудника (переопределяет общий график филиала)
model EmployeeSchedule {
  id         String   @id @default(cuid())
  employeeId String
  dayOfWeek  Int      // 0 = воскресенье ... 6 = суббота
  startTime  String   // "09:00"
  endTime    String   // "18:00"
  isDayOff   Boolean  @default(false)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_schedules")
}

// Общее расписание работы филиала
model WorkingHours {
  id        String @id @default(cuid())
  branchId  String
  dayOfWeek Int
  startTime String
  endTime   String
  isDayOff  Boolean @default(false)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("working_hours")
}

// -----------------------------------------------------
// 3. УСЛУГИ
// -----------------------------------------------------

model ServiceCategory {
  id        String    @id @default(cuid())
  companyId String
  name      String
  order     Int       @default(0)

  services Service[]

  @@map("service_categories")
}

model Service {
  id              String   @id @default(cuid())
  branchId        String
  categoryId      String?
  name            String
  description     String?
  durationMinutes Int      // длительность услуги
  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category     ServiceCategory?  @relation(fields: [categoryId], references: [id])
  employees    EmployeeService[]
  appointments Appointment[]
  ingredients  ServiceIngredient[]

  @@index([branchId])
  @@map("services")
}

// Связь многие-ко-многим: какой сотрудник оказывает какую услугу
model EmployeeService {
  employeeId String
  serviceId  String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
  @@map("employee_services")
}

// -----------------------------------------------------
// 4. КЛИЕНТЫ (CRM)
// -----------------------------------------------------

model Client {
  id            String   @id @default(cuid())
  branchId      String
  firstName     String
  lastName      String?
  phone         String
  email         String?
  birthDate     DateTime?
  notes         String?  // заметки администратора
  loyaltyPoints Int      @default(0)
  totalVisits   Int      @default(0)
  totalSpent    Decimal  @default(0) @db.Decimal(10, 2)
  source        String?  // откуда пришёл: сайт, соцсеть, реклама
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  subscriptions ClientSubscription[]

  @@index([branchId])
  @@index([phone])
  @@map("clients")
}

// -----------------------------------------------------
// 5. ЗАПИСИ (ядро системы)
// -----------------------------------------------------

model Appointment {
  id         String            @id @default(cuid())
  branchId   String
  clientId   String
  employeeId String
  serviceId  String
  startAt    DateTime
  endAt      DateTime
  status     AppointmentStatus @default(PENDING)
  source     BookingSource     @default(WIDGET)
  price      Decimal           @db.Decimal(10, 2) // фиксируем цену на момент записи
  clientComment String?
  internalNote  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  notifications Notification[]
  inventoryTransactions InventoryTransaction[]

  @@index([branchId, startAt])
  @@index([employeeId, startAt])
  @@map("appointments")
}

enum AppointmentStatus {
  PENDING      // ожидает подтверждения
  CONFIRMED    // подтверждена
  COMPLETED    // визит состоялся
  CANCELLED    // отменена
  NO_SHOW      // клиент не пришёл
}

enum BookingSource {
  WIDGET       // виджет на сайте
  ADMIN        // создана администратором вручную
  APP          // мобильное приложение клиента
  SOCIAL       // соцсети
  API          // сторонняя интеграция
}

// -----------------------------------------------------
// 6. УВЕДОМЛЕНИЯ
// -----------------------------------------------------

model Notification {
  id            String             @id @default(cuid())
  appointmentId String
  type          NotificationType
  channel       NotificationChannel
  status        NotificationStatus @default(SCHEDULED)
  scheduledFor  DateTime
  sentAt        DateTime?
  createdAt     DateTime           @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // Крон напоминаний на каждом запуске спрашивает «есть ли уже уведомление
  // такого типа у этой записи». Составной индекс закрывает и этот запрос,
  // и выборку всех уведомлений записи (по левому префиксу).
  //
  // Именно индекс, а не @@unique: created и confirmed пишут по одной строке
  // CONFIRMATION на ту же запись, уникальность их бы сломала.
  @@index([appointmentId, type])
  @@map("notifications")
}

enum NotificationType {
  CONFIRMATION
  REMINDER_24H
  REMINDER_2H
  CANCELLATION
  REVIEW_REQUEST
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
  TELEGRAM
}

enum NotificationStatus {
  SCHEDULED
  SENT
  FAILED
}

// -----------------------------------------------------
// 7. ЛОЯЛЬНОСТЬ И АБОНЕМЕНТЫ
// -----------------------------------------------------

model LoyaltyRule {
  id                String   @id @default(cuid())
  companyId         String
  pointsPerCurrency  Decimal  @default(1) @db.Decimal(5, 2) // баллов за 1 рубль
  redeemRate         Decimal  @default(1) @db.Decimal(5, 2) // рублей за 1 балл при списании
  isActive           Boolean  @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("loyalty_rules")
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  branchId        String
  name            String   // "Абонемент на 8 занятий йоги"
  visitsIncluded  Int
  price           Decimal  @db.Decimal(10, 2)
  validDays       Int      // срок действия в днях с момента покупки

  clientSubscriptions ClientSubscription[]

  @@map("subscription_plans")
}

model ClientSubscription {
  id              String   @id @default(cuid())
  clientId        String
  planId          String
  visitsRemaining Int
  purchasedAt     DateTime @default(now())
  expiresAt       DateTime

  client Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("client_subscriptions")
}

// -----------------------------------------------------
// 8. СКЛАД
// -----------------------------------------------------

// Склад — физическая/логическая группировка товаров внутри филиала.
// У филиала может быть несколько складов ("Расходники", "Товары" и т.п.).
// Два стартовых склада создаются автоматически при создании филиала.
model Warehouse {
  id          String   @id @default(cuid())
  branchId    String
  name        String   // "Расходники", "Товары"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items  InventoryItem[]

  @@index([branchId])
  @@map("warehouses")
}

model InventoryItem {
  id          String   @id @default(cuid())
  warehouseId String
  name        String
  sku         String?  // артикул, опционально
  unit        String   // "шт", "мл", "г"
  quantity    Decimal  @default(0) @db.Decimal(10, 2)
  costPrice   Decimal  @db.Decimal(10, 2)
  // Порог «заканчивается»: если quantity <= minQuantity, подсвечиваем
  // строку в списке. Не влияет на возможность списания.
  minQuantity Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  ingredients  ServiceIngredient[]
  transactions InventoryTransaction[]

  @@index([warehouseId])
  @@map("inventory_items")
}

// Технологическая карта услуги: сколько единиц конкретного товара
// уходит на одну процедуру. При COMPLETED списываем ровно по этой таблице.
model ServiceIngredient {
  id              String  @id @default(cuid())
  serviceId       String
  inventoryItemId String
  quantityUsed    Decimal @db.Decimal(10, 2)

  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  // Один товар — не более одной строки в тех.карте услуги.
  @@unique([serviceId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("service_ingredients")
}

// Журнал движения товара: приход, списание за услугу, ручная
// корректировка. Остаток InventoryItem.quantity — денормализация,
// журнал — источник истины.
model InventoryTransaction {
  id              String                   @id @default(cuid())
  inventoryItemId String
  branchId        String
  type            InventoryTransactionType
  // Знак задаёт направление: RESTOCK — плюс, CONSUMPTION — минус,
  // ADJUSTMENT — любой знак.
  quantity        Decimal                  @db.Decimal(10, 2)
  // Заполняется только для CONSUMPTION — чтобы видеть, за какой визит
  // списан материал.
  appointmentId   String?
  comment         String?
  createdAt       DateTime                 @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
  @@index([branchId, createdAt])
  @@map("inventory_transactions")
}

enum InventoryTransactionType {
  RESTOCK      // приход товара на склад
  CONSUMPTION  // списание при завершении визита
  ADJUSTMENT   // ручная корректировка остатка
}

// -----------------------------------------------------
// 9. ПОДПИСКА КОМПАНИИ НА ПЛАТФОРМУ (монетизация)
// -----------------------------------------------------

model Subscription {
  id            String             @id @default(cuid())
  companyId     String             @unique
  plan          SubscriptionTier   @default(TRIAL)
  employeeSeats Int                @default(3)
  status        SubscriptionStatus @default(TRIAL)
  trialEndsAt   DateTime?
  currentPeriodEnd DateTime?
  createdAt     DateTime           @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubscriptionTier {
  TRIAL
  STARTER
  GROWTH
  PRO
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}
