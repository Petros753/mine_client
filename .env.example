# PostgreSQL connection string
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/booking_platform?schema=public"

# Email-уведомления (Resend — https://resend.com)
# Без RESEND_API_KEY письма не отправляются, а выводятся в консоль сервера.
RESEND_API_KEY=""
EMAIL_FROM="Booking Platform <onboarding@resend.dev>"
