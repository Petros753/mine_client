# PostgreSQL connection string
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/booking_platform?schema=public"

# Auth.js (NextAuth v5): секрет для подписи JWT-сессии.
# Сгенерировать: npx auth secret  (или openssl rand -base64 32)
AUTH_SECRET=""

# В production Auth.js не доверяет заголовку Host, если приложение хостится
# не на Vercel. Включай только за обратным прокси, который сам выставляет
# Host / X-Forwarded-Host — иначе адрес можно подделать.
AUTH_TRUST_HOST="true"

# Email-уведомления (Resend — https://resend.com)
# Без RESEND_API_KEY письма не отправляются, а выводятся в консоль сервера.
RESEND_API_KEY=""
EMAIL_FROM="Booking Platform <onboarding@resend.dev>"
